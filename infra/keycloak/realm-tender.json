{
  "realm": "tender",
  "enabled": true,
  "displayName": "Tender Intelligence",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "analyst",
        "description": "Uploads tenders, reviews extracted findings, corrects values."
      },
      {
        "name": "manager",
        "description": "Everything an analyst can do, plus approving or overriding a recommendation."
      },
      {
        "name": "admin",
        "description": "User administration and system configuration."
      }
    ]
  },
  "clients": [
    {
      "clientId": "tender-api",
      "name": "Tender Intelligence API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false
    },
    {
      "clientId": "tender-frontend",
      "name": "Tender Intelligence Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ]
}
