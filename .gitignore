# Environment
.env
.env.local
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.so
.Python
venv/
.venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Node
node_modules/
dist/
dist-ssr/
.vite/
*.local
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Data — never commit tender documents or corpora
data/seed/*
!data/seed/.gitkeep
data/golden/*
!data/golden/.gitkeep
!data/golden/README.md
*.pdf
!docs/**/*.pdf

# Storage volumes
minio-data/
postgres-data/
redis-data/

# Filesystem storage backend (development without Docker)
var/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Source deck (kept locally, not in repo history)
*.pptx

# Scraped tender cache, regenerated by scripts/scrape_tenders.py
data/cache/

# Celery Beat's schedule file, written next to the worker at runtime.
celerybeat-schedule
backend/celerybeat-schedule

# Trust material for a TLS-inspecting network: environment-specific, not part
# of the project, and nothing anyone else's build should inherit. The folder
# is kept so docker-compose's mount target exists; see RUNNING.md for how to
# produce the file on a network that needs it.
infra/certs/*.crt
infra/certs/*.pem
