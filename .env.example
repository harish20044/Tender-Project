# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Supabase (database, storage, auth) ------------------------------------
# Create a project at https://supabase.com, then fill these from its
# dashboard. See RUNNING.md for the exact steps (enabling pgvector and
# pg_trgm, creating the storage bucket, and where each value below lives in
# Settings).
#
# Settings -> Database -> Connection string (URI). Also where pgvector and
# pg_trgm live: Database -> Extensions -> enable "vector" and "pg_trgm".
DATABASE_URL=

# Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses all access rules. Server-side only, never sent to the frontend.
# Also what app.storage.supabase uses to talk to the Storage REST API.
SUPABASE_SERVICE_ROLE_KEY=
# Settings -> API -> JWT Settings. Verifies tokens Supabase Auth issues.
SUPABASE_JWT_SECRET=
# Where downloaded tender packs are stored. Create a bucket named
# tender-documents in the Supabase dashboard first (Storage -> New bucket).
SUPABASE_BUCKET=tender-documents
# true: stable public URLs. false: time-limited signed URLs (production).
SUPABASE_PUBLIC_BUCKET=true

# --- Redis (Celery broker + cache) ----------------------------------------
# Leave all three blank to run Celery tasks inline, in the calling process.
# Ingestion then blocks the request, which is wrong for production but makes
# the pipeline developable on a machine that cannot run Redis.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Document storage ------------------------------------------------------
# "supabase" talks to Supabase Storage's own REST API directly (the verified,
# working path). "s3" points at the same storage over its S3-compatible
# endpoint instead. "filesystem" writes to STORAGE_PATH, for offline
# development with no Supabase project configured at all — it has no
# expiring URLs and is not for production.
STORAGE_BACKEND=supabase
STORAGE_PATH=./var/documents

# Only used when STORAGE_BACKEND=s3. https://<project_ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT_URL=
# Settings -> API -> S3 Access Keys (generate one; distinct from the
# service_role key above).
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tender-documents
S3_REGION=us-east-1

# --- Groq (generation) -----------------------------------------------------
# Get a key at https://console.groq.com/keys
# Check what your account can actually reach:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
# Both gpt-oss models reason before answering, and those reasoning tokens are
# billed as completion tokens. On extraction, "low" costs roughly a quarter of
# "high" and reaches the same answer, so it is the default. Raise it only for
# the decision narration, where the argument is harder than the arithmetic.
GROQ_REASONING_EFFORT=low
# Client-side throttle. Keep below your account's actual limits, which are
# visible at https://console.groq.com/settings/limits
GROQ_MAX_RPM=25
GROQ_MAX_TPM=6000
GROQ_MAX_RETRIES=5
GROQ_TIMEOUT_SECONDS=120

# --- Jina AI (embeddings + reranking) --------------------------------------
# Get a key at https://jina.ai/embeddings
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v3
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
# Matryoshka truncation. 512 keeps storage and comparison cost down while
# retaining most retrieval quality. Must match the pgvector column dimension.
JINA_EMBED_DIMENSIONS=512
JINA_EMBED_BATCH_SIZE=64

# --- Pipeline tuning -------------------------------------------------------
# Pages above this trigger a warning about token spend before ingest proceeds.
MAX_DOCUMENT_PAGES=1200
OCR_LANGUAGES=eng
# A page with fewer extractable characters than this is treated as scanned
# and routed to OCR.
OCR_TEXT_THRESHOLD_CHARS=80
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

# --- Portal document downloads ---------------------------------------------
# python scripts/download_documents.py needs the scraper extra, the Tesseract
# program and Chrome. Tesseract on Windows:
#   https://github.com/UB-Mannheim/tesseract/wiki
# Leave TESSERACT_CMD blank when the installer was added to PATH; otherwise
# point it at the executable, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
DOWNLOADS_DIR=
SELENIUM_HEADLESS=true
CAPTCHA_MAX_ATTEMPTS=8
DOWNLOAD_SETTLE_SECONDS=3.0

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
