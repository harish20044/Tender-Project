# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (with pgvector) -------------------------------------------
POSTGRES_USER=tender
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=tender
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://tender:change-me-in-production@postgres:5432/tender

# --- Redis (Celery broker + cache) ----------------------------------------
# Leave all three blank to run Celery tasks inline, in the calling process.
# Ingestion then blocks the request, which is wrong for production but makes
# the pipeline developable on a machine that cannot run Redis.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Document storage ------------------------------------------------------
# "s3" for MinIO or real S3. "filesystem" writes to STORAGE_PATH instead, for
# development where MinIO is unavailable. The filesystem backend has no
# expiring URLs and is not for production.
STORAGE_BACKEND=s3
STORAGE_PATH=./var/documents

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-in-production
S3_BUCKET=tender-documents
S3_REGION=us-east-1

# --- Groq (generation) -----------------------------------------------------
# Get a key at https://console.groq.com/keys
# Check what your account can actually reach:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
# Both gpt-oss models reason before answering, and those reasoning tokens are
# billed as completion tokens. On extraction, "low" costs roughly a quarter of
# "high" and reaches the same answer, so it is the default. Raise it only for
# the decision narration, where the argument is harder than the arithmetic.
GROQ_REASONING_EFFORT=low
# Client-side throttle. Keep below your account's actual limits, which are
# visible at https://console.groq.com/settings/limits
GROQ_MAX_RPM=25
GROQ_MAX_TPM=6000
GROQ_MAX_RETRIES=5
GROQ_TIMEOUT_SECONDS=120

# --- Jina AI (embeddings + reranking) --------------------------------------
# Get a key at https://jina.ai/embeddings
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v3
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
# Matryoshka truncation. 512 keeps storage and comparison cost down while
# retaining most retrieval quality. Must match the pgvector column dimension.
JINA_EMBED_DIMENSIONS=512
JINA_EMBED_BATCH_SIZE=64

# --- Keycloak (authentication) ---------------------------------------------
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=tender
KEYCLOAK_CLIENT_ID=tender-api
KEYCLOAK_CLIENT_SECRET=change-me-in-production
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-production

# --- Pipeline tuning -------------------------------------------------------
# Pages above this trigger a warning about token spend before ingest proceeds.
MAX_DOCUMENT_PAGES=1200
OCR_LANGUAGES=eng
# A page with fewer extractable characters than this is treated as scanned
# and routed to OCR.
OCR_TEXT_THRESHOLD_CHARS=80
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
